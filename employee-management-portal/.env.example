DATABASE_URL=jdbc:postgresql://localhost:5432/employee_management_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-local-postgres-password
JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
JWT_EXPIRATION=86400000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
# Optional one-time provisioning for a new database. Remove both variables after the first successful startup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-12-72-byte-password
# BOOTSTRAP_ADMIN_NAME=Portal Administrator
